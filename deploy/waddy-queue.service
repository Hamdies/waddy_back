[Unit]
Description=Waddi queue worker
After=network.target mysql.service

[Service]
User=deploy
Group=www-data
Restart=always
RestartSec=5
# --max-time recycles the worker hourly so a leaked reference cannot grow
# unbounded; systemd restarts it immediately.
# No connection argument: the worker follows QUEUE_CONNECTION from .env.
# Naming one here means changing the driver silently leaves the worker
# polling the old one while jobs pile up in the new.
ExecStart=/usr/bin/php8.2 /var/www/waddy/artisan queue:work --queue=default --sleep=3 --tries=3 --max-time=3600 --timeout=60
StandardOutput=append:/var/www/waddy/storage/logs/queue.log
StandardError=append:/var/www/waddy/storage/logs/queue.log

[Install]
WantedBy=multi-user.target
